{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": ".",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "e2e",
    "playwright.config.ts",
    "vite",
    "vite.config.mts"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
